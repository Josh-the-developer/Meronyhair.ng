# ============================================================
# Merony Hair.NG – Environment Variables
# Copy to .env and fill with real values. NEVER commit .env
# ============================================================

NODE_ENV=development
PORT=3000

# Required – generate a strong random string (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgresql://merony:strongpassword@localhost:5432/merony_hair_ng

# CORS – set to your frontend origin in production
CORS_ORIGIN=http://localhost:3000

# Admin bootstrap (used only on first run / seed)
ADMIN_EMAIL=admin@meronyhair.ng
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YourStrongPass123!', 12))"
ADMIN_PASSWORD_HASH=

# Paystack (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# Flutterwave (optional)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Cloudinary (or equivalent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (Resend / SendGrid / etc.)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Merony Hair.NG <orders@meronyhair.ng>
EMAIL_SUPPORT=hellomeronyhair@gmail.com

# App
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
